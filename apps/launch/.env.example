# Product Hunt public PKCE client configuration.
# Do not place access tokens or developer tokens in this file.
PRODUCT_HUNT_CLIENT_ID=
PRODUCT_HUNT_REDIRECT_URI=http://localhost:3000/api/producthunt/callback
PRODUCT_HUNT_SCOPES=public private

# Generate a high-entropy value of at least 32 characters.
# Configure this only in your local secret store / Vercel environment.
PRODUCT_HUNT_SESSION_SECRET=
